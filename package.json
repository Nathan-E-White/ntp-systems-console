{
  "name": "ntp-systems-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host 0.0.0.0",
    "start": "bun run dev",
    "build": "tsc -b && bunx --bun vite build",
    "preview": "bunx --bun vite preview --host 0.0.0.0",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@theatre/core": "^0.7.2",
    "@theatre/r3f": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "three": "latest",
    "typescript": "^5",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "eslint": "latest",
    "jsdom": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
