{
  "name": "ntp-systems-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host 0.0.0.0",
    "start": "bun run dev",
    "build": "tsc -b && bunx --bun vite build",
    "preview": "bunx --bun vite preview --host 0.0.0.0",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "proof:browser": "node src/tests/ntp-cdp-smoke.mjs",
    "proof:ci": "bun run typecheck && bun run lint && bun run proof:browser",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "demo:check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@theatre/core": "0.7.2",
    "@theatre/studio": "0.7.2",
    "lucide-react": "1.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.1",
    "three": "0.184.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
