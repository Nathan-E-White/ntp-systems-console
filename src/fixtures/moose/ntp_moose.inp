

# ======================================================================
# NTP-SYS-CONSOLE ADVANCED INPUT: MOOSE MULTIPHYSICS FIXTURE
# ----------------------------------------------------------------------
# File:        ntp_moose.inp
# Case ID:     advanced-moose-ntp-003
# Family:      ntp-sys-console-advanced
# Discipline:  thermal structures / reactor transient surrogate /
#              conjugate heat-transfer metadata
# Agencies:    DOE/NASA-style review fixture for parser demonstration
# Pairing:     ntp_rocet.inp, ntr_high_fidelity_system_model.inp
# ----------------------------------------------------------------------
# Purpose
#   MOOSE-inspired, non-operational input deck for the NTP systems console.
#   The structure intentionally tracks the more advanced ROCETS and MCNP
#   fixtures so the app can cross-link names, panels, state histories,
#   instrumentation points, and geometry regions across disciplines.
#
# Scope represented
#   - axisymmetric r-z thrust assembly thermal surrogate
#   - multi-channel core thermal response and Ledinegg advisory margin
#   - control-drum and auxiliary-poison reactivity proxy variables
#   - iodine/xenon and decay-heat state metadata for trend panels
#   - reflector gamma heating and internal shield heat leak to tank
#   - para/ortho hydrogen conditioning penalty metadata
#   - nozzle/chamber/regenerative wall temperature tracking
#   - optional thrust-vectoring hydraulic bleed penalty cross-link
#   - thrust-frame load-path and gimbal-pivot thermal isolation metadata
#   - core support grid plate thermal/pressure-load survivability proxy
#   - effusion-cooled reflector liner thermal barrier proxy
#   - pogo accumulator pressure-wave damping metadata
#   - helium-purged turbine shaft seal and interstage purge metadata
#   - vibration-neutronic coupling and point-kinetics stability proxy
#   - fluid-hydraulic core grid pressure-drop equation metadata
#   - structural-dynamic frequency map for thrust-frame/pogo isolation
#
# Verification status
#   This is not a validated MOOSE input, not a safety analysis, not a
#   design calculation, and not an executable reactor model.  It is a
#   parser and visualization fixture with deliberately bounded surrogate
#   physics.
# ======================================================================

[Problem]
  type = FEProblem
  coord_type = RZ
[]

[Mesh]
  type = GeneratedMesh
  dim = 2
  nx = 72
  ny = 160
  xmin = 0.00
  xmax = 0.92
  ymin = -1.35
  ymax = 5.40
  elem_type = QUAD4
[]

[GlobalParams]
  family = LAGRANGE
  order = FIRST
  displacements = ''
[]

