[Materials]
  [cermet_fuel_compact_surrogate]
    type = ParsedMaterial
    block = 'reactor_core_inner_zone reactor_core_mid_zone reactor_core_outer_zone reactor_core_axial_segment_A reactor_core_axial_segment_B reactor_core_axial_segment_C'
    property_name = thermal_conductivity
    expression = '22.0 + 0.0016 * fuel_temperature'
    coupled_variables = 'fuel_temperature'
  []

  [graphite_moderator_surrogate]
    type = ParsedMaterial
    block = 'moderator_matrix tie_tube_lattice_proxy core_periphery_graphite'
    property_name = thermal_conductivity
    expression = '48.0 - 0.0075 * moderator_temperature'
    coupled_variables = 'moderator_temperature'
  []

  [beryllium_reflector_surrogate]
    type = ParsedMaterial
    block = 'reactor_reflector_annulus radial_reflector_outer_ring control_drum_bank'
