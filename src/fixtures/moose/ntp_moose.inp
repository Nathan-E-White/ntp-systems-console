# ----------------------------------------------------------------------
# Surrogate thermal equations.  These are intentionally lightweight and
# parser-oriented, but they preserve the component vocabulary used by the
# companion MCNP and ROCETS fixtures.
# ----------------------------------------------------------------------
[Kernels]
  [fuel_energy_storage]
    type = HeatConductionTimeDerivative
    variable = fuel_temperature
  []

  [fuel_radial_axial_conduction]
    type = HeatConduction
    variable = fuel_temperature
  []

  [fuel_prompt_power_source]
    type = BodyForce
    variable = fuel_temperature
    value = 1.0
    function = core_power_profile
  []

  [fuel_decay_heat_source]
    type = BodyForce
    variable = fuel_temperature
    value = 0.18
    function = decay_heat_profile
  []

  [moderator_energy_storage]
    type = HeatConductionTimeDerivative
    variable = moderator_temperature
  []

  [moderator_conduction]
    type = HeatConduction
    variable = moderator_temperature
  []

  [reflector_energy_storage]
    type = HeatConductionTimeDerivative
    variable = reflector_temperature
  []

  [reflector_conduction]
    type = HeatConduction
    variable = reflector_temperature
  []

  [reflector_gamma_heat_source]
    type = BodyForce
    variable = reflector_temperature
    value = 0.45
    function = reflector_gamma_heat_profile
  []

  [shield_energy_storage]
    type = HeatConductionTimeDerivative
    variable = shield_temperature
  []

  [shield_conduction]
    type = HeatConduction
    variable = shield_temperature
  []

  [shield_radiation_deposition_proxy]
    type = BodyForce
    variable = shield_temperature
    value = 0.20
    function = tank_shield_heat_leak_profile
  []

  [tank_wall_energy_storage]
    type = HeatConductionTimeDerivative
    variable = tank_wall_temperature
  []

  [tank_wall_conduction]
    type = HeatConduction
    variable = tank_wall_temperature
  []

  [tank_wall_shield_heat_pickup]
    type = BodyForce
    variable = tank_wall_temperature
    value = 0.05
    function = tank_shield_heat_leak_profile
  []

  [coolant_energy_storage]
    type = HeatConductionTimeDerivative
    variable = coolant_temperature
  []

  [coolant_axial_transport_proxy]
    type = BodyForce
    variable = coolant_temperature
    value = 1.0
    function = mass_flow_profile
  []

  [coolant_ortho_para_penalty_proxy]
    type = BodyForce
    variable = coolant_temperature
    value = -0.15
    function = ortho_para_enthalpy_penalty_profile
  []

  [regen_wall_energy_storage]
    type = HeatConductionTimeDerivative
    variable = regen_wall_temperature
  []

  [regen_wall_conduction]
    type = HeatConduction
    variable = regen_wall_temperature
  []

  [chamber_wall_energy_storage]
    type = HeatConductionTimeDerivative
    variable = chamber_wall_temperature
  []

  [chamber_wall_conduction]
    type = HeatConduction
    variable = chamber_wall_temperature
  []

  [nozzle_wall_energy_storage]
    type = HeatConductionTimeDerivative
    variable = nozzle_wall_temperature
  []

  [nozzle_wall_conduction]
    type = HeatConduction
    variable = nozzle_wall_temperature
  []

  [gimbal_ring_energy_storage]
    type = HeatConductionTimeDerivative
    variable = gimbal_ring_temperature
  []

  [gimbal_ring_conduction]
    type = HeatConduction
    variable = gimbal_ring_temperature
  []

  [gimbal_bleed_heating_proxy]
    type = BodyForce
    variable = gimbal_ring_temperature
    value = 0.12
    function = gimbal_hydraulic_bleed_profile
  []

  [thrust_frame_energy_storage]
    type = HeatConductionTimeDerivative
    variable = thrust_frame_temperature
  []

  [thrust_frame_conduction]
    type = HeatConduction
    variable = thrust_frame_temperature
  []

  [thrust_frame_load_heating_proxy]
    type = BodyForce
    variable = thrust_frame_temperature
    value = 2.5e-8
    function = thrust_load_profile
  []

  [core_support_grid_energy_storage]
    type = HeatConductionTimeDerivative
    variable = core_support_grid_temperature
  []

  [core_support_grid_conduction]
    type = HeatConduction
    variable = core_support_grid_temperature
  []

  [core_support_grid_pressure_heating_proxy]
    type = BodyForce
    variable = core_support_grid_temperature
    value = 4.0e-8
    function = core_support_grid_pressure_drop_profile
  []

  [core_support_grid_coupled_loss_feedback_proxy]
    type = BodyForce
    variable = coolant_temperature
    value = -2.0e-8
    function = grid_coupled_pressure_drop_profile
  []

  [reflector_liner_energy_storage]
    type = HeatConductionTimeDerivative
    variable = reflector_liner_temperature
  []

  [reflector_liner_conduction]
