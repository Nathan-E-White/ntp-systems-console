[BCs]
  [cold_propellant_inlet]
    type = DirichletBC
    variable = coolant_temperature
    boundary = n_regen_inlet
    value = 82.0
  []

  [core_exit_heat_pickup_proxy]
    type = ConvectiveFluxBC
    variable = fuel_temperature
    boundary = n_core_exit_plenum
    T_infinity = 2550.0
    heat_transfer_coefficient = 1.5e4
  []

  [core_channel_wall_cooling_proxy]
    type = ConvectiveFluxBC
    variable = fuel_temperature
    boundary = core_cooling_channel_walls
    T_infinity = 1250.0
    heat_transfer_coefficient = 2.2e4
  []

  [regen_outer_wall_sink]
    type = FunctionNeumannBC
    variable = regen_wall_temperature
    boundary = regen_outer_wall
    function = regen_wall_sink_profile
  []

  [chamber_outer_wall_adiabatic]
    type = NeumannBC
    variable = chamber_wall_temperature
    boundary = chamber_outer_wall
    value = 0.0
  []

  [nozzle_outer_radiation_proxy]
    type = FunctionNeumannBC
    variable = nozzle_wall_temperature
    boundary = nozzle_outer_wall
    function = nozzle_radiation_sink_profile
  []

  [forward_shield_thermal_isolation]
    type = NeumannBC
    variable = shield_temperature
    boundary = forward_shadow_shield_face
    value = 0.0
  []

  [tank_dome_cryogenic_sink]
    type = DirichletBC
    variable = tank_wall_temperature
    boundary = lh2_tank_forward_dome
    value = 22.5
  []

  [gimbal_actuator_external_sink]
    type = NeumannBC
    variable = gimbal_ring_temperature
    boundary = gimbal_bearing_outer_case
    value = 0.0
  []

  [thrust_frame_upper_stage_thermal_isolation]
    type = NeumannBC
    variable = thrust_frame_temperature
    boundary = primary_load_ring
    value = 0.0
  []

  [thrust_frame_gimbal_pivot_heat_pickup]
    type = ConvectiveFluxBC
    variable = thrust_frame_temperature
    boundary = gimbal_pivot_mount
    T_infinity = 620.0
    heat_transfer_coefficient = 120.0
  []

  [core_support_grid_hot_hydrogen_exposure]
    type = ConvectiveFluxBC
    variable = core_support_grid_temperature
    boundary = exit_end_fuel_element_seats
    T_infinity = 2700.0
    heat_transfer_coefficient = 1.1e4
  []

  [reflector_liner_effusion_cold_side]
    type = ConvectiveFluxBC
    variable = reflector_liner_temperature
    boundary = effusion_cooling_plenum
    T_infinity = 160.0
    heat_transfer_coefficient = 8.0e3
  []

  [pogo_accumulator_cryogenic_manifold_sink]
    type = ConvectiveFluxBC
    variable = pogo_accumulator_temperature
    boundary = accumulator_discharge_manifold
    T_infinity = 95.0
    heat_transfer_coefficient = 5.0e2
  []

  [shaft_seal_helium_purge_sink]
    type = ConvectiveFluxBC
    variable = shaft_seal_temperature
    boundary = helium_interstage_purge_block
    T_infinity = 290.0
    heat_transfer_coefficient = 9.0e2
  []
[]

