[Executioner]
  type = Transient
  solve_type = NEWTON
  scheme = bdf2
  start_time = 0.0
  end_time = 900.0
  dt = 0.25
  dtmin = 1.0e-6
  dtmax = 1.0
  nl_rel_tol = 1.0e-7
  nl_abs_tol = 1.0e-9
  nl_max_its = 35
  l_tol = 1.0e-6
  l_max_its = 150
[]

[Outputs]
  exodus = false
  csv = true
  perf_graph = true
  interval = 4
[]

