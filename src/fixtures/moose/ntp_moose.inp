  []

  [thrust_frame_composite_surrogate]
    type = ParsedMaterial
    block = 'thrust_structure_alignment_cone primary_load_ring aft_load_ring gimbal_pivot_mount thrust_frame_truss_members'
    property_name = thermal_conductivity
    expression = '7.5 + 0.003 * thrust_frame_temperature'
