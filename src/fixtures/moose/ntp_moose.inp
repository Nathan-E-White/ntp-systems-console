  []

  [hydraulic_gimbal_ring_surrogate]
    type = ParsedMaterial
    block = 'dual_axis_hydraulic_actuator_ring gimbal_bearing_carrier hot_gas_bleed_hydraulic_loop'
    property_name = thermal_conductivity
    expression = '21.0 + 0.006 * gimbal_ring_temperature'
