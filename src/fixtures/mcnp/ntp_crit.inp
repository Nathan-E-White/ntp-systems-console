C --- Criticality source proxy -----------------------------------------
C KCODE/KSRC are included for parser and UI coverage only.  The geometry,
C materials, and source distribution are not validated for criticality.
KCODE  5000  1.00000  50  250
KSRC   0.000  0.000  0.950
KSRC   0.000  0.000  1.150
KSRC   0.000  0.000  1.350
KSRC   0.000  0.000  1.550
KSRC   0.000  0.000  1.750

C --- Burnup / depletion parser study ----------------------------------
C These cards are intentionally compact, synthetic, and app-facing.  They
C give the parser realistic hooks for burnable cells, power history, and
C burn-step reporting without representing an operational MCNP design.
BURN   MAT=2 POWER=1.00E-03 PFRAC=1.0 BOPT=1
C      $ synthetic_core_burnup_study; burnable_material=M2
C      $ burnable_cells=23-40; study_units=MWd_kgHM_proxy
BURNUP 0.00  0.01  0.05  0.10  0.25  0.50
C      $ short_restart_memory_burnup_grid_for_parser_coverage
C      $ depletion_outputs=keff,actinides,iodine135,xenon135,decay_heat
C      $ predictor_corrector=synthetic_fixture_placeholder
C      $ recoverable_energy_per_fission=parser_default_proxy
C      $ normalization=notional_power_history_only

C --- Minimal criticality/burnup tallies --------------------------------
C These are deliberately lightweight report hooks, not replacement design
C tallies.  They let the parser associate the criticality/burnup run with
C axial core regions, reflector/control regions, and the Ledinegg monitor.
F4:N    23 24 25 26 27 28
C       $ crit_core_axial_segment_A_flux_proxy
F14:N   29 30 31 32 33 34
C       $ crit_core_axial_segment_B_flux_proxy
F24:N   35 36 37 38 39 40
C       $ crit_core_axial_segment_C_flux_proxy
F34:N   19 20 21 22
C       $ crit_reflector_control_poison_vessel_flux_proxy
F84:N   41
C       $ crit_ledinegg_virtual_channel_monitor_flux_proxy
FM34    1.0
FM84    1.0

C --- Problem controls --------------------------------------------------
PRINT   60

