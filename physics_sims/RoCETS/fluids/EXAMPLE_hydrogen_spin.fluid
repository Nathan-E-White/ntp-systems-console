! ====================================================================
! ROCETS MULTI-SPECIES FLUID DATA DECK: ORTHO VS PARA HYDROGEN
! FILE: fluids/hydrogen_spin.fluid
! ====================================================================

DEFINE FLUID_DATA: HYDROGEN_SPIN_ISOMERS

BEGIN_BOUNDS
    P_MIN    = 14.7
    P_MAX    = 3000.0
    T_MIN    = 20.0       ! Deep cryogenic limit (Kelvin)
    T_MAX    = 600.0      ! High-temperature gas limit
END_BOUNDS

BEGIN_TABLE_GRID
    ! Dimension 1: Para-hydrogen mass fraction (0 = 100% Ortho, 1 = 100% Para)
    DIMENSION_1: PARA_FRACTION  POINTS = 3   VALUES = [0.0, 0.25, 1.0]

    ! Dimension 2: Pressure (psia)
    DIMENSION_2: PRESSURE       POINTS = 2   VALUES = [50.0, 500.0]

    ! Dimension 3: Temperature (Kelvin)
    DIMENSION_3: TEMPERATURE    POINTS = 2   VALUES = [20.0, 100.0]

    OUTPUT_FIELDS = [DENSITY, ENTHALPY, SPECIFIC_HEAT, VISCOSITY]
END_TABLE_GRID

BEGIN_DATA_BLOCK

  ! ------------------------------------------------------------------
  ! GRID NODE 1: PARA_FRACTION = 0.0 (Pure Ortho-Hydrogen)
  ! ------------------------------------------------------------------
  BLOCK_PARA = 0.0
    BLOCK_P = 50.0
      ! TEMP     DENSITY    ENTHALPY   SPEC_HEAT  VISCOSITY
      ! (K)      (LBM/FT3)  (BTU/LBM)  (BTU/LBM-R) (LBM/FT-S)
        20.0     4.42       -105.2     2.10       7.2E-6
       100.0     0.82        142.1     3.42       1.5E-5
    BLOCK_P = 500.0
        20.0     4.51       -101.4     2.08       7.5E-6
       100.0     0.95        138.6     3.38       1.6E-5

  ! ------------------------------------------------------------------
  ! GRID NODE 2: PARA_FRACTION = 0.25 ("Normal" Room-Temp Equilibrium)
  ! ------------------------------------------------------------------
  BLOCK_PARA = 0.25
    BLOCK_P = 50.0
        20.0     4.42       -112.5     2.45       7.2E-6
       100.0     0.82        131.0     3.85       1.5E-5
    ! ... [Data points follow] ...

  ! ------------------------------------------------------------------
  ! GRID NODE 3: PARA_FRACTION = 1.0 (Pure Para-Hydrogen - Stable Rocket Propellant)
  ! ------------------------------------------------------------------
  BLOCK_PARA = 1.0
    BLOCK_P = 50.0
        20.0     4.43       -240.8     2.81       7.2E-6  ! Notice much lower enthalpy
       100.0     0.82         95.2     4.98       1.5E-5  ! Notice higher specific heat
    ! ... [Data points follow] ...

END_DATA_BLOCK
END_FLUID_DATA
